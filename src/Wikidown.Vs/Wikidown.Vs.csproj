<Project>
  <!--
    Explicit SDK imports: Microsoft.VsSDK.targets must be imported AFTER
    Sdk.targets, because it appends the VSIX targets (GeneratePkgDef,
    CreateVsixContainer, ZipProjects, ...) to PrepareForRunDependsOn — which
    Microsoft.Common.CurrentVersion.targets redefines. With the implicit
    Sdk="..." form the import lands too early and no .vsix is ever produced.
  -->
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <PropertyGroup>
    <!-- VS SDK requires net472; override the global net10.0 from Directory.Build.props -->
    <TargetFramework>net472</TargetFramework>
    <!-- VSSDK package pins are managed locally, not via Directory.Packages.props -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RootNamespace>Wikidown.Vs</RootNamespace>
    <AssemblyName>Wikidown.Vs</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- VSIX build properties -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <CreateVsixContainer>true</CreateVsixContainer>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <!-- Set to true locally for F5 deploy; keep false in CI to avoid side effects -->
    <DeployExtension>false</DeployExtension>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Ensure intermediate files land under obj/, not the filesystem root -->
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    <!-- Explicitly name the VSIX output file -->
    <TargetVsixContainerName>$(AssemblyName).vsix</TargetVsixContainerName>
    <!-- Tell VS where to find the DLL since it's not in the GAC -->
    <UseCodebase>true</UseCodebase>
  </PropertyGroup>

  <ItemGroup>
    <!-- VS 2022 (17.x) SDK meta-package -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.31902.203" PrivateAssets="none" />
    <!-- Build tooling: generates .vsix, .pkgdef, vsixmanifest transforms, template zips -->
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.13.2126" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF references for the Add Wiki Page dialog (DialogWindow) -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <!-- Project node icon -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Include="ProjectTemplate\WikidownProject.vstemplate" />
    <None Include="ProjectTemplate\wiki.wikidownproj" />
    <None Include="ProjectTemplate\__TemplateIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\icon.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Assets</VSIXSubPath>
    </Content>
    <Content Include="Assets\icon-dark.png">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Assets</VSIXSubPath>
    </Content>
    <Content Include="Assets\wikidown.ico">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>Assets</VSIXSubPath>
    </Content>
  </ItemGroup>

  <!-- Exclude NuGet icon include from Directory.Build.props (inapplicable here) -->
  <ItemGroup>
    <None Remove="..\..\assets\nuget-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- LICENSE file required by the vsixmanifest -->
    <Content Include="..\..\LICENSE">
      <Link>LICENSE</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>

  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
  <!-- Must come after Sdk.targets; VSToolsPath is set by the VSSDK.BuildTools NuGet package -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != '' and Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <!--
    Zip the ProjectTemplate\ folder at build time (no hand-built zip is
    checked in) and add it as a VSIX source item under ProjectTemplates\.
    createTemplateManifests then extracts it into the container and emits
    the .vstman manifest VS 2022+ needs for template discovery.
  -->
  <Target Name="PackTemplateZip" BeforeTargets="GetVsixSourceItems">
    <PropertyGroup>
      <_TemplateZip>$(IntermediateOutputPath)Wikidown.zip</_TemplateZip>
    </PropertyGroup>
    <ZipDirectory SourceDirectory="ProjectTemplate" DestinationFile="$(_TemplateZip)" Overwrite="true" />
    <ItemGroup>
      <VSIXSourceItem Include="$(_TemplateZip)">
        <VSIXSubPath>ProjectTemplates</VSIXSubPath>
      </VSIXSourceItem>
      <FileWrites Include="$(_TemplateZip)" />
    </ItemGroup>
  </Target>

  <!-- Fail loudly instead of silently building a DLL-only "success" when the VSSDK targets are missing -->
  <Target Name="EnsureVsSdkTargetsImported" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')"
           Text="Microsoft.VsSDK.targets not found (VSToolsPath='$(VSToolsPath)') — restore Microsoft.VSSDK.BuildTools first." />
  </Target>
</Project>
