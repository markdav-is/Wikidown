@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ConnectionStore Store
@inject GitHubAccount Account
@using Wikidown.Web.Services
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="true">
        <MudLink Href="" Color="Color.Inherit" Underline="Underline.None" Class="d-flex align-center">
            <img src="logo.png" alt="" height="26" style="margin-right:8px;" />
            <MudText Typo="Typo.h6">Wikidown</MudText>
        </MudLink>
        @if (Store.Current is { } conn)
        {
            <MudTooltip Text="Open another wiki">
                <MudButton Href="repos" Color="Color.Inherit" Class="ml-4" Style="text-transform:none"
                           StartIcon="@Icons.Material.Filled.MenuBook" EndIcon="@Icons.Material.Filled.UnfoldMore">
                    @conn.Label
                </MudButton>
            </MudTooltip>
        }
        <MudSpacer />
        <div class="wd-appbar-slot d-flex align-center flex-grow-0">
            <SectionOutlet SectionName="appbar-actions" />
        </div>
        <MudSpacer />
        <DraftsMenu />
        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true">
            <ActivatorContent>
                @if (Account.User?.AvatarUrl is { } avatar)
                {
                    <MudAvatar Size="Size.Small" Class="ml-2" Style="cursor:pointer"><MudImage Src="@avatar" Alt="Account" /></MudAvatar>
                }
                else
                {
                    <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" title="Account" />
                }
            </ActivatorContent>
            <ChildContent>
                @if (Account.User is { } user)
                {
                    <MudText Typo="Typo.body2" Class="px-4 py-2">Signed in as <strong>@user.Login</strong></MudText>
                    <MudDivider />
                }
                <MudMenuItem Href="repos" Icon="@Icons.Material.Filled.MenuBook">Open a wiki</MudMenuItem>
                <MudMenuItem Href="connect" Icon="@Icons.Material.Filled.Link">GitLab or Azure DevOps</MudMenuItem>
                <MudMenuItem Href="https://wikidown.org" Target="_blank" Icon="@Icons.Material.Filled.HelpOutline">Help</MudMenuItem>
                <MudDivider />
                @if (Account.SignedIn)
                {
                    <MudMenuItem OnClick="SignOutAsync" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
                }
                else
                {
                    <MudMenuItem Href="" Icon="@Icons.Custom.Brands.GitHub">Sign in with GitHub</MudMenuItem>
                    @if (Store.Current is not null)
                    {
                        <MudMenuItem OnClick="CloseWikiAsync" Icon="@Icons.Material.Filled.Close">Close this wiki</MudMenuItem>
                    }
                }
            </ChildContent>
        </MudMenu>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="@(IsBrowse ? MaxWidth.False : MaxWidth.Large)" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1f2a40",
            Secondary = "#1b6ec2",
            AppbarBackground = "#1f2a40",
        }
    };

    private bool IsBrowse =>
        Nav.ToBaseRelativePath(Nav.Uri).StartsWith("browse", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += Refresh;
        Account.Changed += Refresh;
        Nav.LocationChanged += OnLocationChanged;
        await Store.LoadAsync();
        await Account.LoadAsync();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => Refresh();

    private async Task SignOutAsync()
    {
        await Account.SignOutAsync();
        await Store.ForgetAsync(WikiProvider.GitHub);
        Nav.NavigateTo("");
    }

    private async Task CloseWikiAsync()
    {
        await Store.ClearAsync();
        Nav.NavigateTo("");
    }

    public void Dispose()
    {
        Store.Changed -= Refresh;
        Account.Changed -= Refresh;
        Nav.LocationChanged -= OnLocationChanged;
    }
}
