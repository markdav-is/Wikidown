    private Task MoveCardAsync(KanbanBoardView.MoveRequest move) =>
        ChangeAsync($"Move {move.Card.Name.Title} to {move.Column.Name.Title}",
            repo => KanbanBoard.MoveCard(repo, _currentPath!, move.Card, move.Column, move.Index));

    private Task AddCardAsync(KanbanBoardView.AddRequest add) =>
        ChangeAsync($"Add {add.Title} to {add.Column.Name.Title}",
            repo => KanbanBoard.AddCard(repo, _currentPath!, add.Column, add.Title));

    private async Task DeleteCardAsync(KanbanCard card)
    {
        var confirmed = await Dialogs.ShowMessageBox($"Delete {card.Title}?",
            "The card and its page will be deleted.", yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
            await ChangeAsync($"Delete {card.Title}", repo => KanbanBoard.RemoveCard(repo, _currentPath!, card.Page));
    }

    private async Task AddColumnAsync()
    {
        var answer = await AskAsync("New column", new DialogParameters<PageDialog>
        {
            { d => d.Parent, _currentPath! },
            { d => d.TitleLabel, "Column name" },
            { d => d.Confirm, "Add" },
        });
