@page "/browse"
@page "/browse/{*Path}"
@inject ConnectionStore Store
@inject BackendResolver Backends
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject DraftStore Drafts
@inject PageImageResolver Images
@inject PagePreview Preview
@using Wikidown.Core
@using Wikidown.Web.Services

<PageTitle>Browse — Wikidown</PageTitle>

@if (_conn is null)
{
    <MudText Typo="Typo.h4" GutterBottom="true">Browse</MudText>
    <MudAlert Severity="Severity.Info">
        No wiki connected. <MudLink Href="connect">Connect one</MudLink>.
    </MudAlert>
}
else
{
    <MudGrid Spacing="3">
        @if (TreeVisible)
        {
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Class="pa-3" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.FolderOpen" />
                    <MudStack Spacing="0" Class="flex-grow-1">
                        <MudText Typo="Typo.subtitle2">@RepoLabel(_conn)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Default">@@@_conn.Branch · /@_conn.DocsPath</MudText>
                    </MudStack>
                    <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small"
                                   title="Export PDF" OnClick="@(() => Nav.NavigateTo("export"))" />
                </MudStack>

                @if (_loadingTree)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_treeError is { } terr)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@terr</MudAlert>
                }
                else if (_tree.Count == 0)
                {
                    <MudText Typo="Typo.body2" Color="Color.Default">
                        No pages found at <code>/@_conn.DocsPath</code>.
                    </MudText>
                }
                else
                {
                    <MudNavMenu Class="wd-tree">
                        <WikiTreeView Nodes="@_tree" Expanded="@_expanded" />
                    </MudNavMenu>
                }
            </MudPaper>
        </MudItem>
        }

        <MudItem xs="12" md="@(TreeVisible ? 8 : 12)" lg="@(TreeVisible ? 9 : 12)">
            @if (_currentPath is null)
            {
                <MudPaper Class="pa-6" Outlined="true">
                    <MudText Typo="Typo.h5">Pick a page</MudText>
                    <MudText>Choose a page from the tree to view or edit it.</MudText>
                </MudPaper>
            }
            else if (_loadingPage)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    <MudText>Loading @_currentPath.ToLinkPath()…</MudText>
                </MudStack>
            }
            else if (_pageError is { } perr)
            {
                <MudText Typo="Typo.h4">@_currentPath.Name.Title</MudText>
                <MudAlert Severity="Severity.Error">@perr</MudAlert>
            }
            else if (_currentPage is { } loaded)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    @if (_editMode)
                    {
                        <MudIconButton Icon="@(_treePinned ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.AccountTree)"
                                       Size="Size.Small" title="@(_treePinned ? "Hide page tree" : "Show page tree")"
                                       OnClick="@(() => _treePinned = !_treePinned)" />
                    }
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h4">@Wikidown.Core.PageTitle.For(loaded.Path, _editMode ? _draft : loaded.Markdown)</MudText>
                            @if (_editMode && HasChanges)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                    Unsaved changes
                                </MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Default">@loaded.Path.ToLinkPath()</MudText>
                    </MudStack>
                    <MudSpacer />
                    @if (_editMode)
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => OnToggleEdit(false))">
                            Done
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                                   OnClick="@(() => OnToggleEdit(true))">
                            Edit
                        </MudButton>
                    }
                </MudStack>

                @if (_editMode)
                {
                    <MudPaper Outlined="true" Class="wd-toolbar mb-2">
                        <EditorToolbar Editor="@_editor" Pages="@_tree" Current="@_currentPath" />
                        <MudSpacer />
                        <MudTextField T="string" @bind-Value="_commitMessage"
                                      Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Placeholder="Commit message" Class="wd-commit" />
                        <MudButton Variant="Variant.Text" OnClick="DiscardDraft"
                                   Disabled="@(!HasChanges || _saving)">
                            Discard
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(!HasChanges || _saving)"
                                   OnClick="SaveAsync">
                            @(_saving ? "Saving…" : "Save")
                        </MudButton>
                    </MudPaper>
                    <MudGrid Spacing="2">
                        @if (_draftRestored)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" ShowCloseIcon="true"
                                          CloseIconClicked="@(() => _draftRestored = false)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                        <MudText>Restored an unsaved draft from this device.</MudText>
                                        <MudSpacer />
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                   OnClick="DiscardDraft">
                                            Use remote
                                        </MudButton>
                                    </MudStack>
                                </MudAlert>
                            </MudItem>
                        }
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Class="wd-editor-pane">
                                <StandaloneCodeEditor @ref="_editor" Id="wd-markdown-editor" CssClass="wd-monaco"
                                                      ConstructionOptions="EditorOptions"
                                                      OnDidInit="OnEditorReady"
                                                      OnDidChangeModelContent="OnEditorChanged" />
                            </MudPaper>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudPaper Outlined="true" Class="pa-3 wd-preview-pane">
                                <div class="wd-preview content">@Preview.Render(_conn!, _currentPath!, _draft)</div>
                            </MudPaper>
                        </MudItem>
                        @if (_conflictMessage is { } conflict)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Warning" ShowCloseIcon="true"
                                          CloseIconClicked="@(() => _conflictMessage = null)">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                                        <MudText>@conflict</MudText>
                                        <MudSpacer />
                                        <MudButton Size="Size.Small" Variant="Variant.Filled"
                                                   Color="Color.Warning" OnClick="ReloadFromRemote">
                                            Reload remote
                                        </MudButton>
                                    </MudStack>
                                </MudAlert>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else
                {
                    <MudPaper Outlined="true" Class="pa-4">
                        <div class="wd-preview content">@Preview.Render(_conn!, _currentPath!, loaded.Markdown)</div>
                    </MudPaper>
                }
            }
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public string? Path { get; set; }

    private WikiConnection? _conn;
    private IReadOnlyList<NavNode> _tree = Array.Empty<NavNode>();
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private bool _loadingTree;
    private string? _treeError;

    private PagePath? _currentPath;
    private RemotePage? _currentPage;
    private bool _loadingPage;
    private string? _pageError;

    private bool _editMode;
    private bool _treePinned;
    private string _draft = string.Empty;
    private StandaloneCodeEditor? _editor;
    private CancellationTokenSource? _typing;
    private string _commitMessage = string.Empty;
    private bool _saving;
    private string? _conflictMessage;
    private bool _draftRestored;

    // The tree yields to the side-by-side editor unless the user pins it back open.
    private bool TreeVisible => !_editMode || _treePinned;

    private bool HasChanges =>
        _currentPage is { } p && !string.Equals(_draft, p.Markdown, StringComparison.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        _conn = await Store.LoadAsync();
        if (_conn is not null) await LoadTreeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_conn is null) return;
        var parsed = string.IsNullOrEmpty(Path) ? null : PagePath.Parse("/" + Path);
        if (Equals(parsed, _currentPath)) return;
        _currentPath = parsed;
        _editMode = false;
        _conflictMessage = null;
        _draftRestored = false;
        ExpandCurrentPath();
        await LoadPageAsync();
    }

    private void ExpandCurrentPath()
    {
        if (_currentPath is null) return;
        // Expand every ancestor (and the page itself, so its subpages show)
        for (var p = _currentPath; !p.IsRoot; p = p.Parent)
            _expanded.Add(p.ToLinkPath());
    }

    private async Task LoadTreeAsync()
    {
        if (_conn is null) return;
        _loadingTree = true;
        _treeError = null;
        try
        {
            var backend = Backends.For(_conn.Provider);
            var snapshot = await backend.WalkAsync(_conn);
            _tree = NavTree.Build(snapshot.Pages, snapshot.OrderFor);
            ExpandCurrentPath();
        }
        catch (Exception ex)
        {
            _treeError = $"Tree load failed: {ex.Message}";
            _tree = Array.Empty<NavNode>();
        }
        finally
        {
            _loadingTree = false;
        }
    }

    private async Task LoadPageAsync()
    {
        if (_conn is null || _currentPath is null) { _currentPage = null; _draft = string.Empty; return; }
        _loadingPage = true;
        _pageError = null;
        _currentPage = null;
        _draftRestored = false;
        try
        {
            var backend = Backends.For(_conn.Provider);
            _currentPage = await backend.ReadPageAsync(_conn, _currentPath);

            var saved = await Drafts.LoadAsync(_conn, _currentPath);
            if (saved is not null && !string.Equals(saved, _currentPage.Markdown, StringComparison.Ordinal))
            {
                _draft = saved;
                _draftRestored = true;
                _editMode = true;
            }
            else
            {
                _draft = _currentPage.Markdown;
            }
            _commitMessage = $"Update {_currentPath.Name.Title}";
            await Images.PrefetchAsync(_conn, _currentPath, _draft);
        }
        catch (Exception ex)
        {
            _pageError = ex.Message;
        }
        finally
        {
            _loadingPage = false;
        }
    }

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor) => new()
    {
        Language = "markdown",
        Value = _draft,
        AutomaticLayout = true,
        WordWrap = "on",
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        FontSize = 14,
    };

    private async Task OnEditorReady()
    {
        if (_editor is not { } editor) return;
        var ctrl = (int)KeyMod.CtrlCmd;
        await editor.AddCommand(ctrl | (int)KeyCode.KeyB,
            args => { _ = InvokeAsync(() => MarkdownCommands.Wrap(editor, "**", "**", "bold text")); });
        await editor.AddCommand(ctrl | (int)KeyCode.KeyI,
            args => { _ = InvokeAsync(() => MarkdownCommands.Wrap(editor, "_", "_", "italic text")); });
        await editor.AddCommand(ctrl | (int)KeyCode.KeyS, args => { _ = InvokeAsync(SaveFromEditor); });
        StateHasChanged();
    }

    // Ctrl+S saves what's in the editor now, not what the debounce last saw.
    private async Task SaveFromEditor()
    {
        _typing?.Cancel();
        if (_editor is not null) await OnDraftChanged(await _editor.GetValue());
        await SaveAsync();
        StateHasChanged();
    }

    // Re-render the preview and save the draft once typing pauses, as the
    // old text field's DebounceInterval did.
    private async Task OnEditorChanged(ModelContentChangedEvent _)
    {
        _typing?.Cancel();
        var typing = _typing = new CancellationTokenSource();
        try { await Task.Delay(200, typing.Token); }
        catch (TaskCanceledException) { return; }
        if (_editor is not null) await OnDraftChanged(await _editor.GetValue());
    }

    private async Task OnDraftChanged(string value)
    {
        _draft = value;
        if (_conn is null || _currentPath is null || _currentPage is null) return;
        await Images.PrefetchAsync(_conn, _currentPath, _draft);
        if (string.Equals(_draft, _currentPage.Markdown, StringComparison.Ordinal))
        {
            await Drafts.ClearAsync(_conn, _currentPath);
        }
        else
        {
            await Drafts.SaveAsync(_conn, _currentPath, _draft);
        }
    }

    private void OnToggleEdit(bool value)
    {
        _editMode = value;
        _conflictMessage = null;
        if (_editMode && _currentPage is { } p)
        {
            if (string.IsNullOrEmpty(_draft)) _draft = p.Markdown;
            if (string.IsNullOrWhiteSpace(_commitMessage) && _currentPath is not null)
                _commitMessage = $"Update {_currentPath.Name.Title}";
        }
    }

    private async Task DiscardDraft()
    {
        if (_currentPage is { } p) _draft = p.Markdown;
        if (_editor is not null) await _editor.SetValue(_draft);
        _conflictMessage = null;
        _draftRestored = false;
        if (_conn is not null && _currentPath is not null)
            await Drafts.ClearAsync(_conn, _currentPath);
    }

    private async Task SaveAsync()
    {
        if (_conn is null || _currentPath is null || _currentPage is null) return;
        if (!HasChanges) return;

        _saving = true;
        _conflictMessage = null;
        try
        {
            var backend = Backends.For(_conn.Provider);
            var msg = string.IsNullOrWhiteSpace(_commitMessage)
                ? $"Update {_currentPath.Name.Title}"
                : _commitMessage.Trim();
            var result = await backend.WritePageAsync(_conn, new CommitRequest(
                _currentPath, _draft, _currentPage.Sha, msg));

            _currentPage = _currentPage with { Markdown = _draft, Sha = result.NewSha };
            await Drafts.ClearAsync(_conn, _currentPath);
            _draftRestored = false;
            Snackbar.Add($"Saved {_currentPath.Name.Title}", Severity.Success);
        }
        catch (WikiConflictException conflict)
        {
            _conflictMessage = conflict.Message;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ReloadFromRemote()
    {
        var keep = _draft;
        await LoadPageAsync();
        // Keep the user's pending edits in the editor so they can hand-merge.
        _draft = keep;
        _conflictMessage = null;
    }

    private static string RepoLabel(WikiConnection c) => c.Provider switch
    {
        WikiProvider.AzureDevOps => $"{c.Owner}/{c.Project}/{c.Repo}",
        _ => $"{c.Owner}/{c.Repo}",
    };
}
