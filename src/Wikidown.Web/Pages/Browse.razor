@page "/browse"
@page "/browse/{*Path}"
@inject ConnectionStore Store
@inject BackendResolver Backends
@inject WikiWorkspace Workspace
@inject GitHubAccount Account
@inject DemoBackend Demo
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject DraftStore Drafts
@inject PageImageResolver Images
@inject PagePreview Preview
@inject IJSRuntime JS
@implements IDisposable
@using Wikidown.Core
@using Wikidown.Web.Services

<PageTitle>@(_currentPath is null ? "Wikidown" : $"{_currentPath.Name.Title} — Wikidown")</PageTitle>

@if (!_loaded)
{
}
else if (_conn is null)
{
    <MudAlert Severity="Severity.Info">
        No wiki is open. <MudLink Href="repos">Open one</MudLink>.
    </MudAlert>
}
else
{
    @if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Secondary" Class="wd-busy" />
    }
    <MudGrid Spacing="3">
        @if (TreeVisible)
        {
        <MudItem xs="12" md="4" lg="3" xl="2">
            <MudPaper Class="pa-3" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                    <MudStack Spacing="0" Class="flex-grow-1" Style="min-width:0">
                        <MudText Typo="Typo.subtitle2" Class="wd-ellipsis">@_conn.Label</MudText>
                        @if (_conn.Provider != WikiProvider.Demo)
                        {
                            <MudText Typo="Typo.caption" Class="wd-ellipsis">@_conn.Branch · /@_conn.DocsPath</MudText>
                        }
                    </MudStack>
                    <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" title="Wiki actions"
                             AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem Icon="@Icons.Material.Filled.Refresh" OnClick="RefreshAsync">Refresh</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" Href="export">Export PDF</MudMenuItem>
                        @if (_conn.Provider == WikiProvider.Demo)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.RestartAlt" OnClick="ResetSampleAsync">Reset the sample wiki</MudMenuItem>
                        }
                        @if (_conn.Provider != WikiProvider.Demo)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Tune" OnClick="ChangeSettingsAsync">Branch and folder…</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.OpenInNew" Href="@_conn.BlobLinks.Blob(_conn.DocsPath)" Target="_blank">Open on @_conn.Provider</MudMenuItem>
                        }
                    </MudMenu>
                </MudStack>

                <MudStack Row="true" Spacing="1" Class="mb-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => NewPageAsync(PagePath.Root))">
                        New page
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="_busy"
                               StartIcon="@Icons.Material.Filled.ViewKanban" OnClick="NewKanbanAsync">
                        New kanban
                    </MudButton>
                </MudStack>

                @if (_tree.Count > 0)
                {
                    <MudTextField @bind-Value="_filter" Immediate="true" Placeholder="Find a page…" Clearable="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                }

                @if (_loadingTree && _tree.Count == 0)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else if (_treeError is { } terr)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@terr</MudAlert>
                }
                else if (_tree.Count == 0)
                {
                    <MudText Typo="Typo.body2">
                        There are no pages in <code>/@_conn.DocsPath</code> yet. Press <strong>New page</strong> to start the wiki.
                    </MudText>
                }
                else if (!string.IsNullOrWhiteSpace(_filter))
                {
                    <MudNavMenu Class="wd-tree">
                        @foreach (var hit in Flatten(_tree).Where(n => n.IsPage && Matches(n)).Take(50))
                        {
                            <MudNavLink Href="@($"browse{hit.Path.ToLinkPath()}")" Icon="@Icons.Material.Filled.Article">
                                @hit.Title
                                <MudText Typo="Typo.caption" Class="wd-ellipsis">@hit.Path.Parent.ToLinkPath()</MudText>
                            </MudNavLink>
                        }
                    </MudNavMenu>
                }
                else
                {
                    <MudNavMenu Class="wd-tree">
                        <WikiTreeView Nodes="@_tree" Expanded="@_expanded" OnAction="OnTreeAction" />
                    </MudNavMenu>
                }
            </MudPaper>
        </MudItem>
        }

        <MudItem xs="12" md="@(TreeVisible ? 8 : 12)" lg="@(TreeVisible ? 9 : 12)" xl="@(TreeVisible ? 10 : 12)">
            @if (_currentPath is null)
            {
                <MudPaper Class="pa-6" Outlined="true">
                    @if (_tree.Count == 0 && !_loadingTree && _treeError is null)
                    {
                        <MudText Typo="Typo.h5" GutterBottom="true">Start your wiki</MudText>
                        <MudText Class="mb-4">
                            Pages are Markdown files in <code>/@_conn.DocsPath</code>. The first one is usually called Home.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                                   Disabled="_busy" OnClick="@(() => NewPageAsync(PagePath.Root, "Home"))">
                            Create the first page
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.h5">Pick a page</MudText>
                        <MudText>Choose a page on the left, or press New page.</MudText>
                    }
                </MudPaper>
            }
            else if (_loadingPage && _currentPage is null)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    <MudText>Loading @_currentPath.Name.Title…</MudText>
                </MudStack>
            }
            else if (_pageError is { } perr)
            {
                <MudText Typo="Typo.h4">@_currentPath.Name.Title</MudText>
                <MudAlert Severity="Severity.Error">@perr</MudAlert>
            }
            else if (_currentPage is { } loaded)
            {
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2" Spacing="2">
                    @if (_editMode)
                    {
                        <MudIconButton Icon="@(_treePinned ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.AccountTree)"
                                       Size="Size.Small" title="@(_treePinned ? "Hide page tree" : "Show page tree")"
                                       OnClick="@(() => _treePinned = !_treePinned)" />
                    }
                    <MudStack Spacing="0" Style="min-width:0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h4" Class="wd-ellipsis">@Wikidown.Core.PageTitle.For(loaded.Path, _editMode ? _draft : loaded.Markdown)</MudText>
                            @if (_editMode && HasChanges)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Outlined">
                                    Unsaved changes
                                </MudChip>
                            }
                        </MudStack>
                        <MudText Typo="Typo.caption">@loaded.Path.ToLinkPath()</MudText>
                    </MudStack>
                    <MudSpacer />
                    @if (_editMode)
                    {
                        <MudToggleGroup T="EditView" Value="_view" ValueChanged="SetViewAsync" Size="Size.Small"
                                        Color="Color.Primary" Outlined="true" Delimiters="true" Class="wd-view-toggle">
                            <MudToggleItem Value="EditView.Editor" title="Editor only"><MudIcon Icon="@Icons.Material.Filled.EditNote" Size="Size.Small" /></MudToggleItem>
                            <MudToggleItem Value="EditView.Split" title="Editor and preview"><MudIcon Icon="@Icons.Material.Filled.VerticalSplit" Size="Size.Small" /></MudToggleItem>
                            <MudToggleItem Value="EditView.Preview" title="Preview only"><MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /></MudToggleItem>
                        </MudToggleGroup>
                        <MudButton Variant="Variant.Text" OnClick="DiscardDraft" Disabled="@(!HasChanges || _saving)">
                            Discard
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save"
                                   Disabled="@(!HasChanges || _saving)" OnClick="SaveAsync">
                            @(_saving ? "Saving…" : "Save")
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => SetEditAsync(false))">Done</MudButton>
                    }
                    else
                    {
                        @if (_board is not null)
                        {
                            <MudToggleGroup T="bool" @bind-Value="_showBoard" Size="Size.Small" Color="Color.Primary"
                                            Outlined="true" Delimiters="true" Class="wd-view-toggle">
                                <MudToggleItem Value="true"><MudIcon Icon="@Icons.Material.Filled.ViewKanban" Size="Size.Small" Class="mr-1" />Board</MudToggleItem>
                                <MudToggleItem Value="false"><MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Small" Class="mr-1" />Page</MudToggleItem>
                            </MudToggleGroup>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit"
                                   Disabled="_busy" OnClick="@(() => SetEditAsync(true))">
                            Edit
                        </MudButton>
                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true" title="Page actions" Disabled="_busy"
                                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                            <MudMenuItem Icon="@Icons.Material.Filled.NoteAdd" OnClick="@(() => NewPageAsync(loaded.Path))">New subpage</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="@(() => RenameAsync(loaded.Path))">Rename</MudMenuItem>
                            <MudMenuItem Icon="@Icons.Material.Filled.DriveFileMove" OnClick="@(() => MoveAsync(loaded.Path))">Move to…</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => DeleteAsync(loaded.Path))">Delete</MudMenuItem>
                        </MudMenu>
                    }
                </MudStack>

                @if (_editMode)
                {
                    @if (_view != EditView.Preview)
                    {
                        <MudPaper Outlined="true" Class="wd-toolbar mb-2">
                            <EditorToolbar Editor="@_editor" Pages="@_tree" Current="@_currentPath" OnImage="OnImagePicked" />
                            <MudSpacer />
                            @if (_uploading)
                            {
                                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                                <MudText Typo="Typo.caption">Uploading image…</MudText>
                            }
                            <MudTextField T="string" @bind-Value="_commitMessage"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Placeholder="Describe the change (optional)" Class="wd-commit" />
                        </MudPaper>
                    }
                    @if (_draftRestored)
                    {
                        <MudAlert Severity="Severity.Info" ShowCloseIcon="true" Dense="true" Class="mb-2"
                                  CloseIconClicked="@(() => _draftRestored = false)">
                            Picked up your unsaved draft from this device.
                            <MudLink OnClick="DiscardDraft" Class="ml-2">Discard it and use the saved page</MudLink>
                        </MudAlert>
                    }
                    @if (_conflictMessage is { } conflict)
                    {
                        <MudAlert Severity="Severity.Warning" ShowCloseIcon="true" Dense="true" Class="mb-2"
                                  CloseIconClicked="@(() => _conflictMessage = null)">
                            @conflict
                            <MudLink OnClick="ReloadFromRemote" Class="ml-2">Keep my text and save over it</MudLink>
                        </MudAlert>
                    }
                    <MudGrid Spacing="2">
                        @if (_view != EditView.Preview)
                        {
                            <MudItem xs="12" md="@(_view == EditView.Split ? 6 : 12)">
                                <MudPaper Outlined="true" Class="wd-editor-pane">
                                    <StandaloneCodeEditor @ref="_editor" Id="wd-markdown-editor" CssClass="wd-monaco"
                                                          ConstructionOptions="EditorOptions"
                                                          OnDidInit="OnEditorReady"
                                                          OnDidChangeModelContent="OnEditorChanged" />
                                </MudPaper>
                            </MudItem>
                        }
                        @if (_view != EditView.Editor)
                        {
                            <MudItem xs="12" md="@(_view == EditView.Split ? 6 : 12)">
                                <MudPaper Outlined="true" Class="pa-4 wd-preview-pane">
                                    <div class="wd-preview content">@Preview.Render(_conn!, _currentPath!, _draft)</div>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
                else if (_board is { } board && _showBoard)
                {
                    <KanbanBoardView Board="board" Busy="_busy" OnMove="MoveCardAsync" OnAdd="AddCardAsync"
                                     OnDelete="DeleteCardAsync" OnAddColumn="AddColumnAsync" />
                }
                else
                {
                    <MudPaper Outlined="true" Class="pa-4">
                        <div class="wd-preview content">@Preview.Render(_conn!, _currentPath!, loaded.Markdown)</div>
                    </MudPaper>
                }
            }
        </MudItem>
    </MudGrid>
}

@code {
    private const string ViewKey = "wikidown.editview";
    private const int MaxImageBytes = 10 * 1024 * 1024;

    [Parameter] public string? Path { get; set; }

    private bool _loaded;
    private WikiConnection? _conn;
    private IReadOnlyList<NavNode> _tree = Array.Empty<NavNode>();
    private readonly HashSet<string> _expanded = new(StringComparer.OrdinalIgnoreCase);
    private bool _loadingTree;
    private string? _treeError;
    private string _filter = "";
    private bool _busy;

    private PagePath? _currentPath;
    private RemotePage? _currentPage;
    private bool _loadingPage;
    private string? _pageError;
    private KanbanBoard? _board;
    private bool _showBoard = true;

    private bool _editMode;
    private bool _editWhenLoaded;
    private bool _cursorAtEnd;
    private EditView _view = EditView.Split;
    private bool _treePinned;
    private string _draft = string.Empty;
    private StandaloneCodeEditor? _editor;
    private DotNetObjectReference<Browse>? _self;
    private CancellationTokenSource? _typing;
    private string _commitMessage = string.Empty;
    private bool _saving;
    private bool _uploading;
    private string? _conflictMessage;
    private bool _draftRestored;

    // The tree yields to the side-by-side editor unless the user pins it back open.
    private bool TreeVisible => !_editMode || _treePinned;

    private bool HasChanges =>
        _currentPage is { } p && !string.Equals(_draft, p.Markdown, StringComparison.Ordinal);

    private IWikiBackend Backend => Backends.For(_conn!.Provider);

    protected override async Task OnInitializedAsync()
    {
        _conn = await Store.LoadAsync();
        await Account.LoadAsync();
        try
        {
            if (Enum.TryParse<EditView>(await JS.InvokeAsync<string?>("localStorage.getItem", ViewKey), out var view))
                _view = view;
        }
        catch (JSException) { }
        _loaded = true;
        if (_conn is null) return;
        await LoadTreeAsync();
        // Land on the wiki's home page rather than an empty pane.
        if (string.IsNullOrEmpty(Path) && _tree.FirstOrDefault(n => n.IsPage && n.Path.IsTopLevelHome) is { } home)
            Nav.NavigateTo(Route(home.Path), replace: true);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_conn is null) return;
        var parsed = string.IsNullOrEmpty(Path) ? null : PagePath.Parse("/" + Path);
        if (parsed?.ToLinkPath() == _currentPath?.ToLinkPath()) return;
        _currentPath = parsed;
        _editMode = false;
        _conflictMessage = null;
        _draftRestored = false;
        _showBoard = true;
        ExpandCurrentPath();
        await LoadPageAsync();
    }

    private void ExpandCurrentPath()
    {
        if (_currentPath is null) return;
        for (var p = _currentPath; !p.IsRoot; p = p.Parent)
            _expanded.Add(p.ToLinkPath());
    }

    private async Task LoadTreeAsync()
    {
        if (_conn is null) return;
        _loadingTree = true;
        _treeError = null;
        try
        {
            var snapshot = await Backend.WalkAsync(_conn);
            _tree = NavTree.Build(snapshot.Pages, snapshot.OrderFor);
            ExpandCurrentPath();
        }
        catch (Exception ex)
        {
            _treeError = $"Couldn't load the wiki: {ex.Message}";
            _tree = Array.Empty<NavNode>();
        }
        finally
        {
            _loadingTree = false;
        }
    }

    private async Task LoadPageAsync()
    {
        if (_conn is null || _currentPath is null)
        {
            _currentPage = null;
            _board = null;
            _draft = string.Empty;
            return;
        }
        var path = _currentPath;
        _loadingPage = true;
        _pageError = null;
        _draftRestored = false;
        try
        {
            var page = await Backend.ReadPageAsync(_conn, path);
            if (path.ToLinkPath() != _currentPath?.ToLinkPath()) return;
            _currentPage = page;
            _board = KanbanBoard.TryParse(path, page.Markdown);

            var saved = await Drafts.LoadAsync(_conn, path);
            if (saved is not null && !string.Equals(saved, page.Markdown, StringComparison.Ordinal))
            {
                _draft = saved;
                _draftRestored = true;
                _editMode = true;
            }
            else
            {
                _draft = page.Markdown;
                if (_editWhenLoaded) _editMode = _cursorAtEnd = true;
            }
            _editWhenLoaded = false;
            _commitMessage = string.Empty;
            await Images.PrefetchAsync(_conn, path, _draft);
        }
        catch (Exception ex)
        {
            _currentPage = null;
            _board = null;
            _pageError = $"Couldn't open this page: {ex.Message}";
        }
        finally
        {
            _loadingPage = false;
        }
    }

    private async Task ResetSampleAsync()
    {
        await Demo.ResetAsync();
        if (_currentPath is null) await RefreshAsync();
        else { await LoadTreeAsync(); Nav.NavigateTo("browse"); }
    }

    private async Task RefreshAsync()
    {
        await LoadTreeAsync();
        if (!_editMode) await LoadPageAsync();
    }

    // ---------- pages and folders

    /// <summary>Runs a change through the workspace as one commit, then shows the wiki as it now is.</summary>
    private async Task<bool> ChangeAsync(string message, Action<WikiRepository> change, string? navigateTo = null)
    {
        if (_conn is null) return false;
        _busy = true;
        StateHasChanged();
        try
        {
            await Workspace.RunAsync(_conn, message, change);
            await LoadTreeAsync();
            if (navigateTo is not null && navigateTo != CurrentRoute) Nav.NavigateTo(navigateTo);
            else await LoadPageAsync();
            return true;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            await RefreshAsync();
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private string CurrentRoute => _currentPath is null ? "browse" : Route(_currentPath);

    private static string Route(PagePath page) => "browse" + page.ToLinkPath();

    private Task OnTreeAction(TreeAction action) => action.Kind switch
    {
        TreeActionKind.NewSubpage => NewPageAsync(action.Node.Path),
        TreeActionKind.Rename => RenameAsync(action.Node.Path),
        TreeActionKind.Move => MoveAsync(action.Node.Path),
        TreeActionKind.MoveUp => ReorderAsync(action.Node.Path, -1),
        TreeActionKind.MoveDown => ReorderAsync(action.Node.Path, +1),
        TreeActionKind.Delete => DeleteAsync(action.Node.Path),
        _ => Task.CompletedTask,
    };

    private async Task<PageDialog.Result?> AskAsync(string heading, DialogParameters<PageDialog> parameters)
    {
        parameters.Add(d => d.Nodes, _tree);
        var dialog = await Dialogs.ShowAsync<PageDialog>(heading, parameters,
            new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: PageDialog.Result answer } ? answer : null;
    }

    private async Task NewPageAsync(PagePath parent, string suggestion = "")
    {
        var answer = await AskAsync("New page", new DialogParameters<PageDialog>
        {
            { d => d.ShowParent, _tree.Count > 0 },
            { d => d.Parent, parent },
            { d => d.Title, suggestion },
            { d => d.TitleLabel, "Page title" },
            { d => d.Confirm, "Create" },
            { d => d.LinkOption, "Add a link to it on the page it sits under" },
        });
        if (answer is null) return;

        var page = answer.Parent.Append(PageName.FromTitle(answer.Title));
        _editWhenLoaded = true;
        var created = await ChangeAsync($"Add {answer.Title}", repo =>
        {
            repo.Write(new WikiPage(page, $"# {answer.Title}\n\n"));
            if (answer.Link && repo.Exists(answer.Parent))
                repo.Append(answer.Parent, $"- [{answer.Title}]({MarkdownCommands.RelativeLink(answer.Parent, page)})");
        }, Route(page));
        if (!created) _editWhenLoaded = false;
    }

    private async Task NewKanbanAsync()
    {
        var answer = await AskAsync("New kanban", new DialogParameters<PageDialog>
        {
            { d => d.ShowParent, _tree.Count > 0 },
            { d => d.Title, "Kanban" },
            { d => d.TitleLabel, "Board name" },
            { d => d.Confirm, "Create" },
            { d => d.LinkOption, "Add a link to it on the page it sits under" },
        });
        if (answer is null) return;

        var board = answer.Parent.Append(PageName.FromTitle(answer.Title));
        await ChangeAsync($"Add {answer.Title} kanban", repo =>
        {
            KanbanBoard.Create(repo, board);
            if (answer.Link && repo.Exists(answer.Parent))
                repo.Append(answer.Parent, $"- [{answer.Title}]({MarkdownCommands.RelativeLink(answer.Parent, board)})");
        }, Route(board));
    }

    private async Task RenameAsync(PagePath page)
    {
        var answer = await AskAsync($"Rename {page.Name.Title}", new DialogParameters<PageDialog>
        {
            { d => d.Parent, page.Parent },
            { d => d.Title, page.Name.Title },
            { d => d.TitleLabel, "New name" },
            { d => d.Subject, page },
            { d => d.Confirm, "Rename" },
        });
        if (answer is null) return;
        var target = page.Parent.Append(PageName.FromTitle(answer.Title));
        if (target.ToLinkPath() == page.ToLinkPath()) return;

        var oldTitle = page.Name.Title;
        await RelocateAsync(page, target, $"Rename {oldTitle} to {answer.Title}", repo =>
        {
            // The heading is the page's displayed title; keep it in step when it was just the old name.
            if (!repo.Exists(target)) return;
            var markdown = repo.Read(target).Markdown;
            if (Wikidown.Core.PageTitle.FromMarkdown(markdown) != oldTitle) return;
            var lines = markdown.Split('\n');
            var heading = Array.FindIndex(lines, l => l.TrimEnd('\r') == $"# {oldTitle}");
            if (heading < 0) return;
            lines[heading] = lines[heading].Replace($"# {oldTitle}", $"# {answer.Title}");
            repo.Write(new WikiPage(target, string.Join('\n', lines)));
        });
    }

    private async Task MoveAsync(PagePath page)
    {
        var answer = await AskAsync($"Move {page.Name.Title}", new DialogParameters<PageDialog>
        {
            { d => d.ShowTitle, false },
            { d => d.ShowParent, true },
            { d => d.Parent, page.Parent },
            { d => d.Subject, page },
            { d => d.Confirm, "Move" },
        });
        if (answer is null) return;
        var target = answer.Parent.Append(page.Name);
        if (target.ToLinkPath() == page.ToLinkPath()) return;
        await RelocateAsync(page, target, $"Move {page.Name.Title} to {(answer.Parent.IsRoot ? "the top level" : answer.Parent.Name.Title)}");
    }

    private async Task RelocateAsync(PagePath from, PagePath to, string message, Action<WikiRepository>? then = null)
    {
        if (!await LeaveEditorAsync()) return;
        string? follow = null;
        if (_currentPath is { } current && IsWithin(current, from))
            follow = Route(current.Segments.Skip(from.Segments.Count).Aggregate(to, (path, segment) => path.Append(segment)));

        await ChangeAsync(message, repo =>
        {
            var rewrites = MoveLinkRewriter.MoveAndRewrite(repo, from, to);
            then?.Invoke(repo);
            if (from.Name.Title == to.Name.Title) return;

            // Links that showed the old name as their text follow the rename too.
            foreach (var rewrite in rewrites.DistinctBy(r => (r.Page.ToLinkPath(), r.NewTarget)))
            {
                var page = IsWithin(rewrite.Page, from)
                    ? rewrite.Page.Segments.Skip(from.Segments.Count).Aggregate(to, (path, segment) => path.Append(segment))
                    : rewrite.Page;
                var old = $"[{from.Name.Title}]({rewrite.NewTarget})";
                if (repo.Exists(page) && repo.Read(page).Markdown.Contains(old, StringComparison.Ordinal))
                    repo.Edit(page, old, $"[{to.Name.Title}]({rewrite.NewTarget})", replaceAll: true);
            }
        }, follow);
    }

    private async Task ReorderAsync(PagePath page, int direction)
    {
        var siblings = SiblingsOf(_tree, page);
        if (siblings is null) return;
        var names = siblings.Select(n => n.Path.Name.FileBase).ToList();
        var index = names.FindIndex(n => string.Equals(n, page.Name.FileBase, StringComparison.OrdinalIgnoreCase));
        var swap = index + direction;
        if (index < 0 || swap < 0 || swap >= names.Count) return;
        (names[index], names[swap]) = (names[swap], names[index]);
        await ChangeAsync($"Reorder {(page.Parent.IsRoot ? "top-level pages" : page.Parent.Name.Title)}",
            repo => repo.WriteOrder(page.Parent, names));
    }

    private async Task DeleteAsync(PagePath page)
    {
        var node = Flatten(_tree).FirstOrDefault(n => n.Path.ToLinkPath() == page.ToLinkPath());
        var below = node is null ? 0 : Flatten(node.Children).Count(n => n.IsPage);
        var what = below == 0
            ? $"“{page.Name.Title}” will be deleted."
            : $"“{page.Name.Title}” and the {below} page{(below == 1 ? "" : "s")} under it will be deleted.";
        var confirmed = await Dialogs.ShowMessageBox($"Delete {page.Name.Title}?",
            what + " Links to it from other pages will stop working. You can get it back from the repository's history.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true) return;

        if (_currentPath is { } current && IsWithin(current, page))
        {
            if (!await LeaveEditorAsync(discard: true)) return;
            await ChangeAsync($"Delete {page.Name.Title}", repo => repo.Delete(page, deleteSubpages: true),
                page.Parent.IsRoot ? "browse" : Route(page.Parent));
        }
        else
        {
            await ChangeAsync($"Delete {page.Name.Title}", repo => repo.Delete(page, deleteSubpages: true));
        }
    }

    // Structural changes rewrite the open page underneath the editor, so unsaved text is saved first.
    private async Task<bool> LeaveEditorAsync(bool discard = false)
    {
        if (!_editMode) return true;
        await FlushEditorAsync();
        if (HasChanges && !discard)
        {
            await SaveAsync();
            if (HasChanges) return false;
        }
        else if (HasChanges && _conn is not null && _currentPath is not null)
        {
            await Drafts.ClearAsync(_conn, _currentPath);
        }
        _editMode = false;
        return true;
    }

    private async Task ChangeSettingsAsync()
    {
        if (_conn is null) return;
        IReadOnlyList<string> branches = Array.Empty<string>();
        if (_conn.Provider == WikiProvider.GitHub)
        {
            try { branches = await Account.ListBranchesAsync(_conn.Owner, _conn.Repo); }
            catch (Exception) { }
        }
        var dialog = await Dialogs.ShowAsync<WikiSettingsDialog>("Branch and folder", new DialogParameters<WikiSettingsDialog>
        {
            { d => d.Branch, _conn.Branch },
            { d => d.DocsPath, _conn.DocsPath },
            { d => d.Branches, branches },
        }, new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small });
        if (await dialog.Result is not { Canceled: false, Data: WikiSettingsDialog.Result settings }) return;

        _conn = _conn with { Branch = settings.Branch, DocsPath = settings.DocsPath };
        await Store.SaveAsync(_conn);
        _expanded.Clear();
        await LoadTreeAsync();
        if (_currentPath is null) await LoadPageAsync();
        else Nav.NavigateTo("browse");
    }

    private static bool IsWithin(PagePath page, PagePath ancestor) =>
        page.Segments.Count >= ancestor.Segments.Count
        && page.Segments.Take(ancestor.Segments.Count).Select(s => s.FileBase)
            .SequenceEqual(ancestor.Segments.Select(s => s.FileBase), StringComparer.OrdinalIgnoreCase);

    private static IReadOnlyList<NavNode>? SiblingsOf(IReadOnlyList<NavNode> nodes, PagePath page)
    {
        if (nodes.Any(n => n.Path.ToLinkPath() == page.ToLinkPath())) return nodes;
        return nodes.Select(n => SiblingsOf(n.Children, page)).FirstOrDefault(found => found is not null);
    }

    private static IEnumerable<NavNode> Flatten(IEnumerable<NavNode> nodes) =>
        nodes.SelectMany(n => new[] { n }.Concat(Flatten(n.Children)));

    private bool Matches(NavNode node) =>
        node.Title.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
        || node.Path.ToLinkPath().Contains(_filter.Trim().Replace(' ', '-'), StringComparison.OrdinalIgnoreCase);

