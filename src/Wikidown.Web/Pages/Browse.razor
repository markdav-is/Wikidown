    // ---------- editing

    private StandaloneEditorConstructionOptions EditorOptions(StandaloneCodeEditor editor) => new()
    {
        Language = "markdown",
        Value = Breadcrumb.Strip(_draft),
        AutomaticLayout = true,
        WordWrap = "on",
        LineNumbers = "off",
        Folding = false,
        Minimap = new EditorMinimapOptions { Enabled = false },
        ScrollBeyondLastLine = false,
        RenderLineHighlight = "none",
        FontSize = 15,
    };

    private async Task OnEditorReady()
    {
        if (_editor is not { } editor) return;
        var ctrl = (int)KeyMod.CtrlCmd;
        await editor.AddCommand(ctrl | (int)KeyCode.KeyB,
            args => { _ = InvokeAsync(() => MarkdownCommands.Wrap(editor, "**", "**", "bold text")); });
        await editor.AddCommand(ctrl | (int)KeyCode.KeyI,
            args => { _ = InvokeAsync(() => MarkdownCommands.Wrap(editor, "_", "_", "italic text")); });
        await editor.AddCommand(ctrl | (int)KeyCode.KeyK,
            args => { _ = InvokeAsync(() => MarkdownCommands.Link(editor)); });
        await editor.AddCommand(ctrl | (int)KeyCode.KeyS, args => { _ = InvokeAsync(SaveFromEditor); });

        _self ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("wikidown.enhanceEditor", "wd-markdown-editor", _self, ".wd-preview-pane", _cursorAtEnd);
        _cursorAtEnd = false;
        await editor.Focus();
        StateHasChanged();
    }

    // Ctrl+S saves what's in the editor now, not what the debounce last saw.
    private async Task SaveFromEditor()
    {
        await FlushEditorAsync();
        await SaveAsync();
        StateHasChanged();
    }

    private async Task FlushEditorAsync()
    {
        _typing?.Cancel();
        if (_editMode && _view != EditView.Preview && _editor is not null)
            await OnDraftChanged(FromEditor(await _editor.GetValue()));
    }

    // Re-render the preview and save the draft once typing pauses.
    private async Task OnEditorChanged(ModelContentChangedEvent _)
    {
        _typing?.Cancel();
        var typing = _typing = new CancellationTokenSource();
        try { await Task.Delay(200, typing.Token); }
        catch (TaskCanceledException) { return; }
        if (_editor is not null) await OnDraftChanged(FromEditor(await _editor.GetValue()));
    }

    // The breadcrumb line is generated, so the editor doesn't show it; it is
    // put back in front of whatever the editor holds.
    private string FromEditor(string body)
    {
        var saved = _currentPage?.Markdown ?? "";
        return saved[..(saved.Length - Breadcrumb.Strip(saved).Length)] + body;
    }

    private async Task OnDraftChanged(string value)
    {
        _draft = value;
        if (_conn is null || _currentPath is null || _currentPage is null) return;
        await Images.PrefetchAsync(_conn, _currentPath, _draft);
        if (string.Equals(_draft, _currentPage.Markdown, StringComparison.Ordinal))
            await Drafts.ClearAsync(_conn, _currentPath);
        else
            await Drafts.SaveAsync(_conn, _currentPath, _draft);
    }

    private async Task SetEditAsync(bool value)
    {
        if (!value) await FlushEditorAsync();
        _editMode = value;
        _conflictMessage = null;
        if (value && _currentPage is { } p && string.IsNullOrEmpty(_draft)) _draft = p.Markdown;
        if (!value && !HasChanges) await LoadPageAsync();
    }

    private async Task SetViewAsync(EditView view)
    {
        await FlushEditorAsync();
        _view = view;
        try { await JS.InvokeVoidAsync("localStorage.setItem", ViewKey, view.ToString()); }
        catch (JSException) { }
    }

    private async Task DiscardDraft()
    {
        _typing?.Cancel();
        if (_currentPage is { } p) _draft = p.Markdown;
        if (_editor is not null && _view != EditView.Preview) await _editor.SetValue(Breadcrumb.Strip(_draft));
        _conflictMessage = null;
        _draftRestored = false;
        if (_conn is not null && _currentPath is not null)
            await Drafts.ClearAsync(_conn, _currentPath);
    }

    private async Task SaveAsync()
    {
        if (_conn is null || _currentPath is null || _currentPage is null) return;
        if (!HasChanges || _saving) return;

        _saving = true;
        _conflictMessage = null;
        try
        {
            var msg = string.IsNullOrWhiteSpace(_commitMessage)
                ? $"Update {_currentPath.Name.Title}"
                : _commitMessage.Trim();
            var saved = _draft;
            var result = await Backend.WritePageAsync(_conn, new CommitRequest(
                _currentPath, saved, _currentPage.Sha, msg));

            _currentPage = _currentPage with { Markdown = saved, Sha = result.NewSha };
            _board = KanbanBoard.TryParse(_currentPath, saved);
            if (!HasChanges) await Drafts.ClearAsync(_conn, _currentPath);
            _draftRestored = false;
            _commitMessage = string.Empty;
            Snackbar.Add($"Saved {_currentPath.Name.Title}", Severity.Success);
        }
        catch (WikiConflictException)
        {
            _conflictMessage = "Someone else changed this page since you opened it, so it wasn't saved.";
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't save: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    // After a conflict: take the server's version as the new base but keep
    // what's in the editor, so the next Save goes through.
    private async Task ReloadFromRemote()
    {
        if (_conn is null || _currentPath is null) return;
        await FlushEditorAsync();
        try
        {
            _currentPage = await Backend.ReadPageAsync(_conn, _currentPath);
            _conflictMessage = null;
            await SaveAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    // ---------- images

    private async Task OnImagePicked(IBrowserFile? file)
    {
        if (file is null) return;
        if (file.Size > MaxImageBytes)
        {
            Snackbar.Add("That image is over 10 MB.", Severity.Warning);
            return;
        }
        using var buffer = new MemoryStream();
        await file.OpenReadStream(MaxImageBytes).CopyToAsync(buffer);
        await UploadImageAsync(file.Name, file.ContentType, buffer.ToArray());
    }

    [JSInvokable]
    public async Task OnImageFile(string name, string contentType, string base64)
    {
        await UploadImageAsync(name, contentType, Convert.FromBase64String(base64));
        StateHasChanged();
    }

    private async Task UploadImageAsync(string name, string contentType, byte[] bytes)
    {
        if (_conn is null || _currentPath is null || _editor is null) return;
        if (bytes.Length > MaxImageBytes)
        {
            Snackbar.Add("That image is over 10 MB.", Severity.Warning);
            return;
        }

        _uploading = true;
        StateHasChanged();
        try
        {
            var extension = System.IO.Path.GetExtension(name);
            if (extension.Length == 0) extension = ".png";
            var stem = Slug(System.IO.Path.GetFileNameWithoutExtension(name));
            var alt = stem.Replace('-', ' ');
            // Screenshots all arrive as "image.png"; name them after the page instead.
            if (stem.Length == 0 || stem == "image")
            {
                stem = $"{_currentPath.Name.FileBase}-{DateTime.Now:yyyyMMdd-HHmmss}";
                alt = "image";
            }

            var rel = $".attachments/{stem}{extension}";
            if (await Backend.ReadBytesAsync(_conn, rel) is not null)
                rel = $".attachments/{stem}-{DateTime.Now:HHmmss}{extension}";

            await Backend.CommitAsync(_conn, [new FileChange(rel, bytes, IsNew: true)], $"Add {System.IO.Path.GetFileName(rel)}");

            var link = string.Concat(Enumerable.Repeat("../", _currentPath.Segments.Count - 1)) + rel;
            Images.Replace(_conn, _currentPath, link, $"data:{contentType};base64,{Convert.ToBase64String(bytes)}");
            await MarkdownCommands.InsertText(_editor, $"![{alt}]({link})");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Couldn't add the image: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploading = false;
        }
    }

    private static string Slug(string name) =>
        string.Join('-', new string(name.Select(c => char.IsLetterOrDigit(c) || c is '.' or '_' ? c : '-').ToArray())
            .Split('-', StringSplitOptions.RemoveEmptyEntries));

    public void Dispose()
    {
        _typing?.Cancel();
        _self?.Dispose();
    }
}
